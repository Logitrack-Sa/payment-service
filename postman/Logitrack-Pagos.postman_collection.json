{
  "info": {
    "name": "Logitrack · Mercado Pago",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usar solo credenciales de Logitrack. Nunca importar el Access Token de Mercado Pago. Checkout Pro usa el importe de Shipment; el estado se confirma mediante Webhook y consulta al proveedor."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Acceso a Logitrack",
      "item": [
        {
          "name": "Login de cliente o administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set(\"accessToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Pago del envío",
      "item": [
        {
          "name": "Consultar estado sin inferir aprobación del retorno",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/payments/shipments/{{shipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Consulta autorizada\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Moneda ARS\", () => pm.expect(pm.response.json().currency).to.eql(\"ARS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear o recuperar checkout - importe calculado en backend",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/payments/shipments/{{shipmentId}}/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout creado\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Enlace seguro\", () => pm.expect(pm.response.json().checkoutUrl).to.match(/^https:\\/\\//));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Controles de acceso y firma",
      "item": [
        {
          "name": "Consulta anónima rechazada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/payments/shipments/{{shipmentId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"JWT obligatorio\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Webhook sin firma rechazado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/payments/webhooks/mercadopago?data.id=123456",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment\",\n  \"data\": {\n    \"id\": \"123456\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Firma obligatoria\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
